# ==============================================================================
# CLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` and populate with your project credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INSTITUTION & BRANDING CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Clio"
NEXT_PUBLIC_APP_TAGLINE="Knowledge, preserved."
NEXT_PUBLIC_APP_DESCRIPTION="A shared academic resource library where college students discover, upload, organize, preview, and download notes, previous-year question papers, lab manuals, and other academic PDFs."
NEXT_PUBLIC_COLLEGE_NAME="Your College or University Name"
NEXT_PUBLIC_COLLEGE_SHORT_NAME="College"
NEXT_PUBLIC_COLLEGE_DOMAIN="yourcollege.edu"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. ADMISSION & ACCESS CONTROL POLICY
# ------------------------------------------------------------------------------
# Registration policy modes:
#  - 'open': Any valid email address can register. Recommended for local testing.
#  - 'domain_restricted': Restricts registration to the allowed institutional domains.
#  - 'invite_only': Self-registration is disabled.
#
# NOTE ON PRODUCTION SECURITY: Client-side domain checks provide user feedback,
# but true server-side enforcement must be configured in your Supabase Auth settings
# (Authentication -> URL Configuration / Providers -> Email -> Allowed Email Domains)
# before public launch to prevent bypassing client forms.
NEXT_PUBLIC_REGISTRATION_MODE="open"

# Comma-separated list of allowed domains for 'domain_restricted' mode:
# (Replace with your institution's real domain before switching to domain_restricted)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS="yourcollege.edu,student.yourcollege.edu"

# ------------------------------------------------------------------------------
# 3. SUPABASE (DATABASE & AUTHENTICATION)
# Obtain these from your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public publishable key for browser and client-side queries (formerly anon key)
# Note: NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for backward compatibility.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# Secret key for trusted server-side admin operations ONLY (formerly service role key)
# NEVER expose this key to client-side code, browser bundles, or git commits!
# Note: SUPABASE_SERVICE_ROLE_KEY is also accepted for backward compatibility.
SUPABASE_SECRET_KEY="your-secret-key-here"

# ------------------------------------------------------------------------------
# 4. DOCUMENT STORAGE: DIRECT GOOGLE DRIVE UPLOAD INTEGRATION
# ------------------------------------------------------------------------------
# Clio uploads student-submitted documents directly from the secure Next.js backend
# to a designated folder in the administrator's Google Drive account via the
# official Google Drive API v3 (using the narrow 'drive.file' OAuth scope).
#
# Setup Steps:
# 1. Create a Google Cloud Project with the Google Drive API enabled.
# 2. Configure OAuth Consent Screen (Internal for Google Workspace, or External with test users).
# 3. Create OAuth 2.0 Web Client ID with redirect URI:
#    http://localhost:3000/api/admin/google-drive/callback
# 4. Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below.
# 5. Connect as admin by visiting /api/admin/google-drive/auth.
#    Clio will automatically create or discover the dedicated 'Clio Academic Library'
#    folder in Google Drive (under the narrow 'drive.file' scope) and display both
#    GOOGLE_DRIVE_FOLDER_ID and GOOGLE_REFRESH_TOKEN to paste into .env.local.
#
# Server-side OAuth 2.0 Credentials (NEVER expose to client/browser):
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REFRESH_TOKEN="your-obtained-refresh-token"

# Destination Google Drive Dedicated Library Folder ID:
# (Automatically created and displayed upon visiting /api/admin/google-drive/auth)
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# File Sharing Policy:
# When true, Clio automatically grants reader permission ("anyone with the link")
# specifically and only to each uploaded file so students can view it in the in-app viewer.
# Clio NEVER alters permissions on the parent folder or any other Drive files.
GOOGLE_DRIVE_ENABLE_PUBLIC_SHARING="true"

# Maximum upload file size in Megabytes (defaults to 50 MB):
NEXT_PUBLIC_MAX_FILE_SIZE_MB="50"
